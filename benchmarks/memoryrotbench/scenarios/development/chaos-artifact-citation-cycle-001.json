      "label": "acme_run",
      "proposal": {
        "proposal_id": "proposal-acme",
        "idempotency_key": "key-acme",
        "claim_id": "claim.alice_acme",
        "subject": "user:alice",
        "predicate": "works_at",
        "object_value": "Acme",
        "evidence_spans": [
          {
            "observation_id": "obs-1",
            "start": 0,
            "end": 15
          }
        ]
      },
      "expect": {
        "status": "committed"
      }
    },
    {
      "step_id": "s2",
      "type": "refresh_artifact",
