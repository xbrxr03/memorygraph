        "exception": "ValueError"
      }
    }
  ],
  "final_assertion": {
    "version": 1,
    "active_claim_ids": ["claim.alice_acme"],
    "evidence_ids": ["obs-1"],
    "current_view": [["user:alice|works_at", "claim.alice_acme"]],
    "artifact_ids": ["artifact_v1"],
    "committed_run_ids": ["acme_run"],
    "history_claim_ids": ["claim.alice_acme"]
  }
